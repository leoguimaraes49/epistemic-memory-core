# Python & Ambiente
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
env/

# Estado de execucao local e bancos SQLite
estado/
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.lock
*.log

# Modelos pesados (>100MB nao permitidos no GitHub sem Git LFS)
modelos/
*.onnx

# Cofres e workspaces locais gerados pelo usuário
meu-cofre/
meu-dossie/
my-dossier/

# Diretorios temporarios de testes
testes_temporarios/*
!testes_temporarios/.gitkeep
.pytest_cache/

# Variaveis locais e caches
.env
*.local
/execucao.json
